# ─────────────────────────────────────────────────────────────
# SIS environment configuration (E0-4)
# Copy to .env.local and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Supabase — client-safe (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase — SERVER ONLY. Bypasses RLS. Never expose to the browser,
# never prefix with NEXT_PUBLIC_. Used only by scheduled/admin jobs.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Brevo (transactional email — E0-6 / E7 reminders). Server only.
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="notifications@yourdomain.example"
BREVO_SENDER_NAME="SIS Notifications"

# App
NEXT_PUBLIC_APP_NAME="SIS"
# Corporate email domain used for sign-in hints (e.g. company.com)
NEXT_PUBLIC_ORG_EMAIL_DOMAIN="example.com"

# Demo mode: shows the "Continue as — demo roles" switcher on /login (E1-4).
# Set to "false" (or remove) for a real deployment where sign-in = SSO only.
NEXT_PUBLIC_DEMO_MODE="true"
# Shared password for the demo seed users (server-only). Used by the demo
# sign-in action and scripts/setup-demo-auth.mjs. Not a real secret.
DEMO_LOGIN_PASSWORD="change-me-demo"
